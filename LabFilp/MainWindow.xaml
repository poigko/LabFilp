<Window x:Class="LabFilp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор добрых писем" Height="838" Width="800" WindowStyle="ThreeDBorderWindow">
    <Grid Margin="10,10,10,0" Height="802" VerticalAlignment="Top">
        <Image HorizontalAlignment="Left" Height="60" Margin="34,10,0,0" VerticalAlignment="Top" Source="/admlogo.PNG"/>
        <TextBlock HorizontalAlignment="Left" Margin="34,80,0,0" VerticalAlignment="Top" 
                   Text="Издательство AdMarginem&#x0a;105082, Москва&#x0a;Переведеновский переулок, 18, строение 3&#x0a;info@admarginem.ru, client@admarginem.ru" 
                   FontFamily="Times New Roman" FontSize="11"/>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,40,0" Width="200">
            <Label Content="ФИО адресата:" FontStyle="Italic" Padding="0" FontFamily="Times New Roman"/>
            <TextBox x:Name="TxtFullFio" Margin="0,0,0,10" FontFamily="Times New Roman"/>

            <Label Content="Должность:" FontStyle="Italic" Padding="0" FontFamily="Times New Roman"/>
            <TextBox x:Name="TxtPosition" Margin="0,0,0,10" FontFamily="Times New Roman"/>

            <Label Content="Организация:" FontStyle="Italic" Padding="0" FontFamily="Times New Roman"/>
            <TextBox x:Name="TxtOrg" Margin="0,0,0,10" FontFamily="Times New Roman"/>
        </StackPanel>

        <TextBlock HorizontalAlignment="Center" Margin="34,220,34,0" TextWrapping="Wrap" VerticalAlignment="Top" 
                   Text="Пишу вам сразу по приезду, прямо вот только что вошёл и сел писать. Тут всё у нас хорошо, весна вовсю, снег ещё не сошёл, но вроде бы сходит, на дороге намёрзло много, а калитку я еле отодрал — вон как пристыл внизу ледок то! Так что вошёл когда, сразу трубы проверил и понял что целы слава Богу. Ну и действительно — зима то не очень сурова была больше двадцать двух и не было кажется, а для нас это прямо благодать — и яблонки молодые и розы ваши и опять же чтоб трубы не разорвало. Но ничего, всё обошлось, всё тут хорошо." 
                   FontFamily="Times New Roman" TextAlignment="Justify" FontSize="14"/>

        <StackPanel VerticalAlignment="Bottom" Margin="34,0,0,163" HorizontalAlignment="Left">
            <Label Content="Имя отправителя" FontStyle="Italic" FontFamily="Times New Roman"/>
            <TextBox x:Name="TxtSender" Width="200" HorizontalAlignment="Left" 
                     FontFamily="Times New Roman"/>
        </StackPanel>
        <Button x:Name="BtnGenerate" Content="Сформировать письмо" Click="BtnGenerate_Click" 
                    Width="192" Background="#FFE3A0DE" Foreground="White" FontFamily="Arial" HorizontalAlignment="Left" Cursor="Hand" Margin="518,650,0,114"/>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,41,230" Width="250">
            <Label Content="Заголовок приложения:" FontStyle="Italic" Padding="0" FontFamily="Times New Roman"/>
            <TextBox x:Name="TxtAppTitle" Margin="0,0,0,10" FontFamily="Times New Roman"/>

            <TextBox x:Name="TxtAppText" Visibility="Collapsed"/>

            <Button Content="Добавить приложение" Click="BtnAddApp_Click" Height="25" Margin="0,0,0,10" 
                    Background="#FFCAAFCA" Foreground="White" FontFamily="Arial" FontWeight="Bold"/>

            <Label Content="Список приложений:" FontStyle="Italic" Padding="0" FontFamily="Times New Roman"/>
            <ListBox x:Name="LstApplications" DisplayMemberPath="Title" Height="100" Margin="0,0,0,10" FontFamily="Times New Roman"/>

            <Button Content="Удалить выбранное" Click="BtnDeleteApp_Click" Height="22" 
                    Background="#FFAEAEAE" Foreground="White" FontFamily="Arial"/>
        </StackPanel>
        <Label x:Name="label" Content="организация" HorizontalAlignment="Left" Height="11" Margin="540,204,0,0" VerticalAlignment="Top" Width="136"/>
        <Label Content="организация" HorizontalAlignment="Left" Height="25" Margin="282,139,0,0" VerticalAlignment="Top" Width="150"/>
        <TextBox HorizontalAlignment="Left" Height="25" Margin="282,174,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="150"/>
        <Button Content="Button" HorizontalAlignment="Center" Height="25" Margin="0,80,0,0" VerticalAlignment="Top" Width="126" Click="Button_Click"/>
    </Grid>

</Window>